# HubSpot — contact form (route serveur /api/contact)
# Copier ce fichier en .env.local et renseigner les valeurs.
#
# Token d'une clé de service / Private App HubSpot (scope crm.objects.contacts.write).
# NE JAMAIS exposer ce token côté client (pas de NEXT_PUBLIC).
HUBSPOT_PRIVATE_APP_TOKEN=

# (Optionnel) ID propriétaire HubSpot auquel attribuer les contacts du site.
# Par défaut : Hugo Poulaillon (445387662).
HUBSPOT_OWNER_ID=

# Resend — envoi de l'e-mail de brochure (modale « Télécharger la brochure »).
# Clé API Resend (https://resend.com → API Keys).
RESEND_API_KEY=
# Adresse d'expéditeur : doit appartenir à un domaine vérifié dans Resend.
# Ex : "Le Campus Paris <brochure@le-campus-paris.fr>"
BROCHURE_FROM_EMAIL=
