# HubSpot Forms API — formulaire de contact (ContactModal)
# Copier ce fichier en .env.local et renseigner les valeurs de ton compte HubSpot.
# Portal ID (Hub ID) : visible en haut à droite dans HubSpot.
# Form GUID : code d'intégration du formulaire HubSpot (.../submit/{portalId}/{formGuid}).
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_HUBSPOT_FORM_GUID=
